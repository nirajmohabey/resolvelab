APP_ENV=local
DEMO_MODE=true
# Local fixture clock is intentional. Disabled in production.
FIXTURE_CLOCK=2026-11-23T12:00:00Z
DATABASE_URL=postgresql+psycopg://resolvelab_app:replace-me@localhost:55439/resolvelab
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:55439/resolvelab
EVALUATION_DATABASE_URL=postgresql+psycopg://resolvelab_app:replace-me@localhost:55439/resolvelab_evaluation
ADMIN_EVALUATION_DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:55439/resolvelab_evaluation
TEST_DATABASE_URL=postgresql+psycopg://resolvelab_app:replace-me@localhost:55439/resolvelab_test
ADMIN_TEST_DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:55439/resolvelab_test
AUTH_SECRET=replace-with-at-least-32-random-characters
GENERATION_ADAPTER=offline
# Optional live drafts. Set a provider key and an explicit supported model.
OPENAI_API_KEY=
OPENAI_MODEL=
